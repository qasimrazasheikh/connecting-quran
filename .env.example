# Copy to .env.local and fill in. DATABASE_URL is needed for the encyclopedia catalogue (Neon Postgres).
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Curator login for /admin: a long random ADMIN_SECRET (32+ chars) and your ADMIN_PASSWORD (8+ chars).
# ADMIN_SECRET=
# ADMIN_PASSWORD=

# Quran Foundation API client (Developer Console, production). quran.com's text, word data and Indo-Pak load through it.
# CLIENT_ID=
# CLIENT_SECRET=

# The rest are optional. Leave unset to use the public APIs.
# QURAN_CLOUD_API=https://api.alquran.cloud/v1
# QURAN_COM_API=https://apis.quran.foundation/content/api/v4
# QF_AUTH_URL=https://oauth2.quran.foundation/oauth2/token
# TAFSIR_API=https://cdn.jsdelivr.net/gh/spa5k/tafsir_api@main/tafsir
# IP_BACKUP_API=https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1/editions/ara-quranindopak
# MORPH_URL=https://cdn.jsdelivr.net/gh/mustafa0x/quran-morphology@master/quran-morphology.txt
# QURANENC_API=https://quranenc.com/api/v1
# NEXT_PUBLIC_AUDIO_CDN=https://cdn.islamic.network/quran/audio
# NEXT_PUBLIC_WORD_AUDIO_CDN=https://audio.qurancdn.com
