/**
 * Splits the Quranic Arabic Corpus morphology (GPL; mustafa0x/quran-morphology) into one file per surah, data/morph/<s>.json,
 * so the word card reads only its own surah's grammar (~55 KB) instead of downloading and parsing the whole 6.3 MB file
 * on every new server instance. Re-run after the source changes:
 *   node scripts/split-morph.mts                 (downloads the file from MORPH_URL's default)
 *   node scripts/split-morph.mts path/to/quran-morphology.txt
 * Format written: {"<ayah>:<word>": [[text, pos, "TAG|TAG|…"], …]}, segments in order.
 */
import {mkdirSync, readFileSync, writeFileSync} from 'node:fs';

const SRC = 'https://cdn.jsdelivr.net/gh/mustafa0x/quran-morphology@master/quran-morphology.txt';
const OUT = new URL('../data/morph/', import.meta.url);

const arg = process.argv[2];
const txt = arg ? readFileSync(arg, 'utf8') : await (await fetch(SRC)).text();
const bySurah = new Map<number, Record<string, [string, string, string][]>>();
let lines = 0;
for (const line of txt.split('\n')){
  const c = line.replace(/\r$/, '').split('\t');
  if (c.length < 4 || !/^\d+:\d+:\d+:\d+$/.test(c[0])) continue;
  const [s, a, w] = c[0].split(':').map(Number);
  if (!bySurah.has(s)) bySurah.set(s, {});
  (bySurah.get(s)![`${a}:${w}`] ??= []).push([c[1], c[2], c[3]]);
  lines++;
}
if (bySurah.size !== 114) throw new Error(`expected 114 surahs, got ${bySurah.size}`);
mkdirSync(OUT, {recursive: true});
for (const [s, words] of bySurah) writeFileSync(new URL(`${s}.json`, OUT), JSON.stringify(words));
writeFileSync(new URL('README.md', OUT), `# Quran morphology, one file per surah

From the Quranic Arabic Corpus (corpus.quran.com) by Kais Dukes, as published in [mustafa0x/quran-morphology](https://github.com/mustafa0x/quran-morphology),
GNU General Public License. Generated by \`scripts/split-morph.mts\`; do not edit by hand.
`);
console.log(`${lines} segments, ${bySurah.size} surahs -> data/morph/`);
